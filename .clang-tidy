# Narrow and strict: checks that find defects, not checks that have opinions
# about style. The engine is C99 with no dynamic allocation, so most of what
# clang-tidy ships is either inapplicable or actively wrong here — hence the
# leading -* and an explicit opt-in list, then a list of subtractions with a
# reason for each.
#
# The tree is clean against this set, and CI holds it there: any finding is an
# error and fails the merge. That is safe only because CI's clang-tidy version
# is pinned (see the tidy job in native.yml) — a newer release adds checks to
# bugprone-* and cert-* without asking. Moving to one is its own commit.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  portability-*,
  cert-*,
  -bugprone-narrowing-conversions,
  -bugprone-easily-swappable-parameters,
  -bugprone-assignment-in-if-condition,
  -bugprone-switch-missing-default-case,
  -cert-int09-c,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

# Why each of those is off:
#
# bugprone-narrowing-conversions — a software renderer converts between int and
#   float on nearly every line, on purpose. ~60 hits, no signal. Revisit when
#   the fixed-point transition lands; the check may earn its keep then.
# bugprone-easily-swappable-parameters — fires on every (x, y) and (w, h) in a
#   rasterizer.
# bugprone-assignment-in-if-condition, bugprone-switch-missing-default-case —
#   style calls, not defects.
# cert-int09-c — wants all-or-nothing explicit enum values; GAME_SceneTag is
#   deliberately "first one pinned, rest sequential".
# clang-analyzer-security.insecureAPI...  — wants memcpy_s/memset_s. Annex K is
#   optional, glibc does not have it, and neither will DJGPP.
#
# bugprone-reserved-identifier stays on: file-local names are marked with a
#   trailing underscore (kek_apply_scene_switch_), never a leading one, which
#   the standard reserves.
#
# cert-err33-c stays on deliberately: it flags ignored fseek/fread returns in
# the asset provider, which is exactly the class of defect this project cares
# about. Where dropping a result really is right — fclose on a read-only
# stream, snprintf into a debug overlay — say so with a (void) cast; see
# AllowCastToVoid below.

HeaderFilterRegex: '.*/(kek|game|platform)/.*\.h$'
# The filter matches on the absolute path, and a checkout of a repository
# named kek is itself a /kek/ directory — on the CI runner every header under
# build/_deps (SDL3, Unity) matched it. Fetched dependencies are never ours.
ExcludeHeaderFilterRegex: '.*/_deps/.*'

WarningsAsErrors: '*'

CheckOptions:
  # An explicit (void) is the C way of writing "I know, and I do not care
  # here". Without this the only way to quiet cert-err33-c is a NOLINT comment,
  # which says the same thing but to the linter instead of to the reader.
  - key: bugprone-unused-return-value.AllowCastToVoid
    value: 'true'
